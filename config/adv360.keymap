#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"

        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 39 40 41 42 43 44 45 54 55 56 57 58 59 71 72 73 74 75>;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 46 47 48 49 50 51 60 61 62 63 64>;
        };

        bspace: bspace {
            compatible = "zmk,behavior-hold-tap";
            label = "BSPACE";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
        };
    };

    combos {
        compatible = "zmk,combos";

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <41 42>;
            layers = <0>;
        };

        vim_write_all_combo {
            bindings = <&vim_write_all>;
            key-positions = <18 17>;
            layers = <0>;
        };

        vim_write_quit_combo {
            bindings = <&vim_wite_quit>;
            key-positions = <18 16>;
            layers = <0>;
        };

        caps {
            bindings = <&kp RS(CAPSLOCK)>;
            key-positions = <23 25>;
            layers = <0>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <23 24>;
            layers = <0>;
        };
    };

    macros {
        vim_write_all: vim_write_all {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESCAPE &kp COLON &kp W &kp A &kp ENTER>;
            label = "VIM_WRITE_ALL";
        };

        vim_wite_quit: vim_wite_quit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESCAPE &kp COLON &kp W &kp Q &kp A &kp ENTER>;
            label = "VIM_WITE_QUIT";
        };

        plus_one: plus_one {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp PLUS &kp N1 &kp COLON>;
            label = "PLUS_ONE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1           &kp N2           &kp N3             &kp N4        &kp N5  &tog 1                                                                                                    &mo 3  &kp N6  &kp N7        &kp N8              &kp N9           &kp N0            &kp MINUS
&kp TAB    &kp Q            &kp W            &kp F              &kp P         &kp B   &none                                                                                                     &none  &kp J   &kp L         &kp U               &kp Y            &kp SEMICOLON     &kp BSLH
&kp ESC    &hml LEFT_WIN A  &hml LEFT_ALT R  &hml LEFT_SHIFT S  &hml LCTRL T  &kp G   &none                        &kp LCTRL  &kp LALT             &kp LGUI             &kp F12                 &none  &kp M   &hmr RCTRL N  &hmr RIGHT_SHIFT E  &hmr LEFT_ALT I  &hmr RIGHT_GUI O  &kp SQT
&kp LSHFT  &kp Z            &kp X            &kp C              &kp D         &kp V                                           &kp HOME             &kp PG_UP                                           &kp K   &kp H         &kp COMMA           &kp DOT          &kp FSLH          &kp RSHFT
&mo 2      &kp GRAVE        &kp TAB          &kp LEFT           &kp RIGHT                     &bspace 4 BACKSPACE  &lt 1 DEL  &mt RIGHT_ALT END    &mt RCTRL PAGE_DOWN  &kp ENTER  &lt 5 SPACE                 &kp UP        &kp DOWN            &kp LBKT         &kp RBKT          &to 6
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2        &kp N3          &kp N4     &kp N5  &trans                                                                    &mo 3  &none       &plus_one     &none         &none         &none      &none
&kp TAB    &none      &none         &none           &none      &none   &none                                                                     &none  &kp PERIOD  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp MINUS  &none
&kp ESC    &none      &kp LEFT_ALT  &kp LEFT_SHIFT  &kp LCTRL  &none   &none             &kp LCTRL  &kp LALT    &kp LGUI   &kp RCTRL             &none  &kp EQUAL   &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp N0     &none
&kp LSHFT  &none      &none         &none           &none      &none                                &kp HOME    &kp PG_UP                               &kp COMMA   &kp N7        &kp N8        &kp N9        &none      &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS      &kp LEFT        &kp RIGHT                  &kp BSPC  &kp DEL    &kp END     &kp PG_DN  &kp ENTER  &kp SPACE                     &none         &none         &none         &none      &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                                    &mo 3  &kp F7          &kp F8        &kp F9        &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                                     &none  &kp C_PREVIOUS  &kp C_PP      &kp C_NEXT    &none    &none    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none           &trans  &trans    &trans  &trans          &none  &kp C_MUTE      &kp C_VOL_DN  &kp C_VOL_UP  &none    &none    &trans
&trans  &trans  &trans  &trans  &trans  &trans                          &trans    &trans                         &none           &none         &none         &none    &none    &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans    &trans  &trans  &trans                         &trans        &trans        &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                                        &trans        &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                                                  &bootloader   &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none               &none  &none    &bt BT_CLR  &none                        &stp STP_BAT  &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                                    &none    &none                                                  &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                                    &none  &none  &none    &none       &bl BL_TOG  &rgb_ug RGB_TOG                       &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        movement {
            display-name = "Movement";
            bindings = <
&kp EQUAL  &kp N1     &kp N2        &kp N3          &kp N4     &kp N5  &tog 1                                                                                                  &mo 3  &kp N6  &kp N7          &kp N8          &kp N9           &kp N0       &kp MINUS
&kp TAB    &none      &none         &none           &none      &none   &none                                                                                                   &none  &none   &kp STAR        &kp UP_ARROW    &kp N            &kp PERCENT  &kp BSLH
&kp ESC    &none      &kp LEFT_ALT  &kp LEFT_SHIFT  &kp LCTRL  &none   &none                        &kp LCTRL  &kp LALT             &kp LGUI             &kp F12               &none  &kp V   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none        &kp SQT
&kp LSHFT  &none      &none         &none           &none      &none                                           &kp HOME             &kp PG_UP                                         &none   &none           &none           &none            &none        &kp RSHFT
&mo 2      &kp GRAVE  &kp TAB       &kp LEFT        &kp RIGHT                  &bspace 4 BACKSPACE  &lt 1 DEL  &mt RIGHT_ALT END    &mt RCTRL PAGE_DOWN  &kp ENTER  &kp SPACE                 &kp UP          &kp DOWN        &kp LBKT         &kp RBKT     &mo 2
            >;
        };

        layer_8 {
            bindings = <
&trans  &trans    &trans                &trans         &trans                 &trans            &trans                                                    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp STAR  &kp LS(LEFT_BRACKET)  &kp LS(EQUAL)  &kp LS(RIGHT_BRACKET)  &none             &trans                                                    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp HASH  &kp LS(N9)            &kp EQUAL      &kp LS(N0)             &kp SEMICOLON     &trans          &trans  &trans    &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp AMPS  &kp LEFT_BRACKET      &kp MINUS      &kp RIGHT_BRACKET      &kp GREATER_THAN                          &trans    &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &none     &none                 &none          &none                                            &trans  &trans  &trans    &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
            >;
        };

        game {
            display-name = "Cyan";
            bindings = <
&kp EQUAL  &kp N1     &kp N2   &kp N3    &kp N4     &kp N5  &tog 1                                                                                                  &mo 3  &kp N6  &kp N7  &kp N8     &kp N9    &kp N0         &kp MINUS
&kp TAB    &kp Q      &kp W    &kp F     &kp P      &kp B   &none                                                                                                   &none  &kp J   &kp L   &kp U      &kp Y     &kp SEMICOLON  &kp BSLH
&kp ESC    &kp A      &kp R    &kp S     &kp T      &kp G   &none                        &kp LCTRL  &kp LALT             &kp LGUI             &kp F12               &none  &kp M   &kp N   &kp E      &kp I     &kp O          &kp SQT
&kp LSHFT  &kp Z      &kp X    &kp C     &kp D      &kp V                                           &kp HOME             &kp PG_UP                                         &kp K   &kp H   &kp COMMA  &kp DOT   &kp FSLH       &kp RSHFT
&mo 2      &kp GRAVE  &kp TAB  &kp LEFT  &kp RIGHT                  &bspace 4 BACKSPACE  &lt 1 DEL  &mt RIGHT_ALT END    &mt RCTRL PAGE_DOWN  &kp ENTER  &kp SPACE                 &kp UP  &kp DOWN   &kp LBKT  &kp RBKT       &to 0
            >;
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
